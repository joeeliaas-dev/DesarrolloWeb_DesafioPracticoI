rules_version = '2';

// =========================================================
// ADDIKT SKATESHOP — Reglas de seguridad de Cloud Firestore
// Ocultar botones en la página NO es seguridad: estas reglas
// se ejecutan en el servidor de Google y deciden quién puede
// leer o escribir cada documento.
// =========================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones de ayuda ----------
    function estaAutenticado() {
      return request.auth != null;
    }

    // Lee el documento del usuario en /usuarios y revisa su rol
    function esAdmin() {
      return estaAutenticado()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    function esDueno(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    // ---------- usuarios ----------
    match /usuarios/{uid} {
      // Cada quien lee su propio perfil; el admin lee todos
      allow read: if esDueno(uid) || esAdmin();

      // Al registrarse, el perfil SIEMPRE nace con rol "cliente"
      allow create: if esDueno(uid)
        && request.resource.data.rol == 'cliente';

      // Un cliente puede editar su perfil, pero nunca cambiarse el rol
      allow update: if esAdmin()
        || (esDueno(uid) && request.resource.data.rol == resource.data.rol);

      allow delete: if esAdmin();
    }

    // ---------- productos ----------
    match /productos/{productoId} {
      // Catálogo público: cualquier visitante lo puede ver
      allow read: if true;

      // Crear y eliminar: solo administradores
      allow create, delete: if esAdmin();

      // Editar: el admin todo; un cliente autenticado SOLO puede
      // restar stock (cuando confirma una reserva) y nunca dejarlo negativo
      allow update: if esAdmin()
        || (estaAutenticado()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
            && request.resource.data.stock < resource.data.stock
            && request.resource.data.stock >= 0);
    }

    // ---------- mensajes (formulario de contacto) ----------
    match /mensajes/{mensajeId} {
      // Cualquier visitante puede enviar un mensaje, con datos válidos
      allow create: if request.resource.data.keys().hasOnly(['nombre', 'email', 'asunto', 'mensaje', 'creado'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 3 && request.resource.data.nombre.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5 && request.resource.data.email.size() <= 120
        && request.resource.data.asunto in ['cotizacion', 'envios', 'disponibilidad', 'otro']
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() >= 10 && request.resource.data.mensaje.size() <= 1000
        && request.resource.data.creado == request.time;

      // Solo el admin los lee o los borra; nadie los edita
      allow read, delete: if esAdmin();
      allow update: if false;
    }

    // ---------- pedidos (reservas) ----------
    match /pedidos/{pedidoId} {
      // Crear: usuario autenticado, a su nombre y en estado "pendiente"
      allow create: if estaAutenticado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.total > 0;

      // Leer: el dueño del pedido o el admin
      allow read: if estaAutenticado()
        && (resource.data.uid == request.auth.uid || esAdmin());

      // Cambiar estado o borrar: solo el admin
      allow update, delete: if esAdmin();
    }
  }
}
